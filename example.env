# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Trends ---
GOOGLE_TRENDS_ENABLE=true

# --- Amazon / SerpAPI (at least one required for Amazon provider) ---
SERPAPI_API_KEY=
AMAZON_API_KEY=
AMAZON_ASSOCIATE_TAG=

# --- Reddit (optional — falls back to Pushshift.io public API) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ProductAgent/1.0

# --- Future Providers (Phase 2+) ---
PINTEREST_ACCESS_TOKEN=
META_ADS_ACCESS_TOKEN=
ALIEXPRESS_API_KEY=
CJ_API_KEY=

# --- Provider Behavior ---
PROVIDER_CACHE_TTL=3600
PROVIDER_RATE_LIMIT_DELAY=1.0
PROVIDER_MAX_RETRIES=2

# --- Product Research Settings ---
REPORT_OUTPUT_FOLDER=reports
TREND_LOOKBACK_DAYS=180
MIN_MARGIN_PERCENT=60
CONTENT_IDEA_COUNT=50
MIN_CONTENT_UNIQUENESS=70